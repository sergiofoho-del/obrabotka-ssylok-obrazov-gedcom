{
  "manifest_version": 3,
  "name": "Обработка списка ссылок графических образов, и обработка их в Gedcom",
  "version": "1.0.1",
  "description": "Скачивает графические образы (сканы) страниц Яндекс Архива по списку ссылок (.html или .ged), сохраняет таблицу ссылок и записывает ссылки на сканы в GEDCOM-файл.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Сбор данных из Яндекс Архива",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://ya.ru/*",
    "https://yandex.ru/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}